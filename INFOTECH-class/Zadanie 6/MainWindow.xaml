<Window x:Class="Zadanie_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadanie_6"
        mc:Ignorable="d"
        Title="Rejestracja" Height="450" Width="800">
    <Grid>
        <Label Content="Imie" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Nazwisko" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
        <Label Content="Rok Urodzenia" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
        <Label Content="Miesiąc Urodzenia" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top"/>
        <Label Content="Dzień Urodzenia" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="10,165,0,0" VerticalAlignment="Top"/>

        <TextBox x:Name="Name_tb" HorizontalAlignment="Left" Margin="120,10,0,0" VerticalAlignment="Top" Width="610"/>
        <TextBox x:Name="Surname_tb" HorizontalAlignment="Left" Margin="120,40,0,0" VerticalAlignment="Top" Width="610"/>
        <TextBox x:Name="Year_tb" HorizontalAlignment="Left" Margin="120,70,0,0" VerticalAlignment="Top" Width="610"/>
        <TextBox x:Name="Month_tb" HorizontalAlignment="Left" Margin="120,100,0,0" VerticalAlignment="Top" Width="610"/>
        <TextBox x:Name="Day_tb" HorizontalAlignment="Left" Margin="120,130,0,0" VerticalAlignment="Top" Width="610"/>
        <TextBox x:Name="Email_tb" HorizontalAlignment="Left" Margin="120,165,0,0" VerticalAlignment="Top" Width="610"/>

        <Button Content="Dalej" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="100" Height="30" Margin="650,0,0,10" Click="NextButton_Click"/>
    </Grid>
</Window>
