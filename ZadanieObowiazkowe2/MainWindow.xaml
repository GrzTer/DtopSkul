<Window x:Class="ZadanieObowiazkowe2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zegary świata" Height="600" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="300" Margin="0,20,0,0">
            <Ellipse Stroke="Black" StrokeThickness="2"/>
            <TextBlock Text="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <TextBlock Text="9" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>

            <Line x:Name="HourHand" X1="150" Y1="150" X2="150" Y2="100" Stroke="Black" StrokeThickness="6" RenderTransformOrigin="0.5,0.5"/>
            <Line x:Name="MinuteHand" X1="150" Y1="150" X2="150" Y2="60" Stroke="Black" StrokeThickness="4" RenderTransformOrigin="0.5,0.5"/>
            <Line x:Name="SecondHand" X1="150" Y1="150" X2="150" Y2="40" Stroke="Red" StrokeThickness="2" RenderTransformOrigin="0.5,0.5"/>
            <Ellipse Fill="Black" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <ListBox x:Name="CitiesListBox" Margin="10,340,10,60" SelectionChanged="CitiesListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                        <Button Content="⨉" Foreground="Red" FontWeight="Bold" Click="DeleteCity_Click" Grid.Column="1" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="DODAJ" Click="AddCity_Click" Height="40" Margin="10" VerticalAlignment="Bottom"/>
    </Grid>
</Window>