<Window x:Class="Zadanie_egzyminacyjne_3___Bartomiej.Images.PodsumowanieWindo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadanie_egzyminacyjne_3___Bartomiej.Images"
        mc:Ignorable="d"
        Title="PodsumowanieWindoZamowienia" Height="250" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="ExhibitionText" FontSize="14" Margin="0,0,0,10" Text="Wystawa: "/>
            <TextBlock x:Name="TicketsText" FontSize="14" Margin="0,0,0,10" Text="Bilety: "/>
            <TextBlock x:Name="PriceText" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Text="Cena całkowita: "/>

            <Button x:Name="SaveButton" Content="Zatwierdź i zapisz" Padding="8" Click="SaveButton_Click"/>
        </StackPanel>   
    </Grid>
</Window>
