<Window x:Class="Zadanie_5_Konwerter_Jednostek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadanie_5_Konwerter_Jednostek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock FontSize="20" Margin="34,50,0,0" TextWrapping="Wrap" Text="Konwenter jednostek" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="186"/>
        <TextBox Name="TextBoxIn" HorizontalAlignment="Left" Margin="100,150,0,0" TextWrapping="Wrap" Text="Wejście" Width="120" Height="22" VerticalAlignment="Top"/>
        <TextBox Name="TextBoxOut" Margin="0,150,100,0" TextWrapping="Wrap" Text="Wynik" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right" Width="120"  IsReadOnly="True"/>
        <ComboBox Name="ComboBoxIn" HorizontalAlignment="Left" Margin="250,150,0,0" Width="120" Height="22" VerticalAlignment="Top"/>
        <ComboBox Name="ComboBoxOut" Margin="0,150,250,0" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right" Width="120"/>
        <Label Content="=>" HorizontalAlignment="Center" Margin="0,146,0,0" Height="26" VerticalAlignment="Top"/>
        <Button Name="ConvertButton" Content="Przelicz" HorizontalAlignment="Center" Width="76" Margin="0,304,0,0" Click="ConvertButton_Click" Height="30" VerticalAlignment="Top"/>
    </Grid>
</Window>
