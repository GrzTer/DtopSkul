<Window x:Class="Zadanie_egzyminacyjne_2___Ja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadanie_egzyminacyjne_2___Ja"
        mc:Ignorable="d"
        Title="Zegary świata" Height="600" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Grid>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="300" Margin="0,20,0,0">
            <Ellipse Stroke="Black" StrokeThickness="2"/>
            <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" Text="12" FontWeight="Bold" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Right" Margin="0,0,15,0" Text="3" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Center" Margin="0,0,10,0" Text="6" FontWeight="Bold" VerticalAlignment="Bottom"/>
            <TextBlock HorizontalAlignment="Left" Margin="15,0,0,0" Text="9" FontWeight="Bold" VerticalAlignment="Center"/>

            <Line x:Name="HourLine" X1="150" X2="150" Y1="150" Y2="100" Stroke="Black" StrokeThickness="6" RenderTransformOrigin="0.2, 0.2"/>
            <Line x:Name="MinuteLine" X1="150" X2="150" Y1="150" Y2="60" Stroke="Black" StrokeThickness="4" RenderTransformOrigin="0.5, 0.5"/>
            <Line x:Name="SecondLine" X1="150" X2="150" Y1="150" Y2="40" Stroke="Red" StrokeThickness="2" RenderTransformOrigin="0.5, 0.5"/>
        </Grid>
        <ListBox x:Name="CitiesListBox" Margin="10,340,10,60" SelectionChanged="CitiesListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding}" VerticalAlignment="Center"/>
                        <Button Content="X" Foreground="Red" FontWeight="Bold" Grid.Column="1" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="DODAJ" HorizontalAlignment="Center" Margin="0,529,0,0" VerticalAlignment="Top" Height="45" Width="380" Click="Button_Click"/>

    </Grid>
</Window>
