<Window x:Class="ZadanieEzyminacyjne_4___San.WalidatorKolorow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Walidator Kodów" Height="250" Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtWprowadzonyKod" Grid.Row="0" Margin="0,0,0,10" Width="260" HorizontalAlignment="Left"/>

        <Button x:Name="btnWaliduj" Content="Waliduj" Grid.Row="1" Margin="0,0,0,10" Width="260" HorizontalAlignment="Left" Click="btnWaliduj_Click"/>

        <Label x:Name="lblWynikWalidacji" Grid.Row="2" Margin="0,0,0,10"/>

        <Button x:Name="btnPowrot" Content="Powrót" Grid.Row="3" Margin="0,0,0,10" Width="260" HorizontalAlignment="Left" Click="btnPowrot_Click"/>

        <Label x:Name="lblDaneUzytkownika" Grid.Row="4" Margin="0,0,0,10"/>
    </Grid>
</Window>